{
  "name": "paraleet",
  "productName": "ParaLeet",
  "version": "0.1.0",
  "private": true,
  "description": "A pixel-art parakeet that is fed only when you solve today's algorithm problem.",
  "author": "Sandy Yin",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.ui.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "seed:starter": "tsx scripts/seed/build-starter.ts",
    "seed:catalog": "tsx scripts/seed/build-catalog.ts all",
    "seed:leetcode": "tsx scripts/seed/build-catalog.ts leetcode",
    "seed:cses": "tsx scripts/seed/build-catalog.ts cses",
    "seed:codeforces": "tsx scripts/seed/build-catalog.ts codeforces"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
